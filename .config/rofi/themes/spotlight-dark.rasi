/* POLISHED GLASSMORPHISM SPOTLIGHT THEME FOR ROFI */
/* Enhanced from: Newman Sanchez's spotlight-dark */

* {
    font:   "Montserrat 12";

    /* ── Core palette ── */
    bg0:    #242424E6;          /* window: neutral dark, original opacity   */
    bg1:    #7E7E7E80;          /* subtle dividers                         */
    bg2:    #ffffff18;          /* accent: frosted white for selections     */
    bg3:    #ffffff08;          /* glass tint for inputbar                  */
    bg4:    #ffffff0d;          /* mode-switcher button idle bg             */

    fg0:    #DEDEDE;            /* primary text                            */
    fg1:    #FFFFFF;            /* bright text on selected                  */
    fg2:    #DEDEDE80;          /* placeholder / muted text                 */

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   @bg0;
    transparency:       "real";

    location:       center;
    width:          580px;
    border-radius:  14px;
    border:         1px;
    border-color:   #ffffff18;
}

mainbox {
    background-color: transparent;
}

/* ── Input Bar ── */

inputbar {
    font:       "Montserrat 18";
    padding:    16px 20px;
    spacing:    12px;
    children:   [ icon-search, entry ];
    background-color: @bg3;
    border:     0 0 1px 0;
    border-color: #ffffff10;
}

icon-search {
    expand:     false;
    filename:   "search";
    size:       24px;
    vertical-align: 0.5;
}

prompt {
    enabled: false;
}

entry {
    font:               "Montserrat 18";
    padding:            4px 0;
    placeholder:        "Search apps…";
    placeholder-color:  @fg2;
    text-color:         @fg1;
    vertical-align:     0.5;
}

/* ── List View ── */

listview {
    lines:          8;
    columns:        1;
    scrollbar:      false;
    fixed-height:   true;

    padding:        6px 0;
    border:         0;
    background-color: transparent;
}

/* ── Elements (rows) ── */

element {
    padding:            10px 20px;
    spacing:            14px;
    border-radius:      8px;
    margin:             2px 8px;
    background-color:   transparent;
}

element normal active {
    text-color: @fg1;
}

element alternate active {
    text-color: @fg1;
}

element selected normal,
element selected active {
    background-color:   @bg2;
    text-color:         @fg1;
    border:             0 0 0 3px;
    border-color:       #ffffff50;
}

element-icon {
    size:           1.15em;
    vertical-align: 0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    highlight:      bold underline;
}

/* ── Message ── */

message {
    border:             1px 0 0;
    border-color:       @bg1;
    background-color:   @bg3;
}

textbox {
    padding:    10px 24px;
}

/* ── Mode Switcher ── */

mode-switcher {
    enabled:            true;
    border:             1px 0 0 0;
    border-color:       #ffffff10;
    background-color:   transparent;
    padding:            8px 12px;
    spacing:            8px;
}

button {
    font:               "Montserrat 10";
    background-color:   @bg4;
    text-color:         @fg2;
    padding:            8px 16px;
    border-radius:      8px;
    cursor:             pointer;
}

button selected {
    background-color:   @bg2;
    text-color:         @fg1;
}
